{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caju",
  "main": "worker.mjs",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "build": { "command": "node scripts/build-worker-assets.js" },
  "assets": {
    "directory": "./.worker-assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/index.html", "/iletisim.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "caju-clay",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": { "enabled": true }
}
